{
  "mcpServers": {
    "onenote": {
      "command": "/absolute/path/to/uv",
      "args": [
        "--directory",
        "/absolute/path/to/onenote-mcp-server",
        "run",
        "--frozen",
        "onenote-mcp-server"
      ],
      "env": {
        "AZURE_CLIENT_ID": "YOUR_AZURE_CLIENT_ID_HERE",
        "ONENOTE_CACHE_TOKENS": "true",
        "ONENOTE_ENABLE_WRITES": "false",
        "ONENOTE_ENABLE_DELETES": "false"
      }
    }
  }
}
